# Copie para .env.local. Nunca versione valores reais.
DATABASE_URL=postgres://usuario:senha@localhost:5432/cade
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Só para `npm run cms:seed` (primeiro administrador; sem padrões)
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=

# Desenvolvimento: imagens em cms/media-local/ (proibido em produção)
CMS_UPLOAD_LOCAL=true
# Produção: armazenamento de imagens
BLOB_READ_WRITE_TOKEN=

# Formulários do site e e-mails do CMS. Em produção, RESEND_API_KEY e CMS_EMAIL_REMETENTE são
# obrigatórios (recuperação de senha dos editores). Remetente de um domínio verificado no Resend.
RESEND_API_KEY=
CMS_EMAIL_REMETENTE=
RESEND_TO=
RESEND_FROM=

# Opcional: exige verificação de e-mail em novas contas
CMS_VERIFICACAO_EMAIL=
