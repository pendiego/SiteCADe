{
  "discovery": {
    "includeGlobs": [
      "*.html",
      "**/*.html",
      "*.css",
      "**/*.css",
      "*.js",
      "**/*.js",
      "*.ts",
      "**/*.ts",
      "*.tsx",
      "**/*.tsx",
      "*.md",
      "**/*.md"
    ],
    "ignoreGlobs": [
      "public/assets/**",
      "cms/media-local/**",
      "cms/migrations/**",
      ".next/**",
      ".vercel/**",
      ".codegraph/**",
      "node_modules/**",
      "scratch/**",
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.webp",
      "**/*.gif",
      "**/*.svg",
      "**/*.ico",
      "**/*.woff",
      "**/*.woff2",
      "**/*.ttf",
      "**/*.otf",
      "**/*.eot"
    ],
    "useGitignore": true
  }
}
